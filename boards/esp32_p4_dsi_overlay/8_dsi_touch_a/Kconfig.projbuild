# Selects the 8-DSI-TOUCH-A initialization sequence inside waveshare/esp_lcd_jd9365.
# The driver picks its vendor init table with CONFIG_BSP_LCD_TYPE_* at compile
# time, so this amend carries the symbol instead of asking the user to set it.
config BSP_LCD_TYPE_800_1280_8_INCH_A
    bool
    default y

config BOARD_DISPLAY_LAYOUT_800_1280
    bool
    default y
