CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_SPIFFS_SUPPORT=y

# Keep the board pack usable on ESP32-P4 v3.x. Projects targeting v1.x ROM
# must override this with CONFIG_ESP32P4_SELECTS_REV_LESS_V3 and a matching
# CONFIG_ESP32P4_REV_MIN_* value in their own sdkconfig defaults.
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
